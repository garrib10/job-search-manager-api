# Application configuration
APP_NAME=Job Search Manager API
APP_VERSION=0.1.0
# development | test | production. With production, the app refuses to start
# if the settings below are unsafe (see docs/design-decisions.md).
APP_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_search_manager
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

TEST_DATABASE_URL=mysql+pymysql://job_manager_user:your_password_here@localhost/job_search_manager_test

# At least 32 bytes for HS256 (48 for HS384, 64 for HS512). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_secure_random_secret_here
# HS256, HS384, or HS512
JWT_ALGORITHM=HS256
# 1 to 1440 (24 hours) in production
ACCESS_TOKEN_EXPIRE_MINUTES=30